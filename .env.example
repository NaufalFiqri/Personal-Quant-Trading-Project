# Copy this file to .env and fill in your real Alpaca paper trading
# credentials. .env is gitignored - never commit real keys.
#
# Get these from app.alpaca.markets -> log in -> make sure the dashboard is
# showing the "Paper Trading" account (not live) -> API Keys panel ->
# generate a key. The secret is only shown once at generation time.

ALPACA_API_KEY=your_paper_api_key_id_here
ALPACA_API_SECRET=your_paper_api_secret_here

# Paper trading base URL - deliberately explicit rather than hardcoded in
# code, so there is no risk of an env-specific typo silently pointing at the
# live-trading domain (https://api.alpaca.markets) instead.
ALPACA_BASE_URL=https://paper-api.alpaca.markets
